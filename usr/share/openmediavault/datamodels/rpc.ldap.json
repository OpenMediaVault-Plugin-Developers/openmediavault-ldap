[
  {
    "type": "rpc",
    "id": "rpc.ldap.setsettings",
    "params": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "boolean",
          "required": true
        },
        "backend": {
          "type": "string",
          "enum": ["nslcd", "sssd"],
          "required": true
        },
        "host": {
          "type": "string",
          "required": true
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "required": true
        },
        "enablessl": {
          "type": "boolean",
          "required": true
        },
        "enablestarttls": {
          "type": "boolean",
          "required": true
        },
        "tlsreqcert": {
          "type": "string",
          "enum": ["never", "allow", "try", "demand", "hard"],
          "required": true
        },
        "base": {
          "type": "string",
          "required": true
        },
        "rootbinddn": {
          "type": "string",
          "required": true
        },
        "rootbindpw": {
          "type": "string",
          "required": true
        },
        "usersuffix": {
          "type": "string",
          "required": false
        },
        "groupsuffix": {
          "type": "string",
          "required": false
        },
        "machinesuffix": {
          "type": "string",
          "required": false
        },
        "idmapsuffix": {
          "type": "string",
          "required": false
        },
        "enablepam": {
          "type": "boolean",
          "required": true
        },
        "cachecredentials": {
          "type": "boolean",
          "required": true
        },
        "enumerate": {
          "type": "boolean",
          "required": true
        },
        "extraoptions": {
          "type": "string",
          "required": true
        },
        "extraclientoptions": {
          "type": "string",
          "required": true
        }
      }
    }
  }
]
