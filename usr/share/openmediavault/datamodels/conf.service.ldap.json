{
  "type": "config",
  "id": "conf.service.ldap",
  "title": "LDAP",
  "queryinfo": {
    "xpath": "//services/ldap",
    "iterable": false
  },
  "properties": {
    "enable": {
      "type": "boolean",
      "default": true
    },
    "backend": {
      "type": "string",
      "enum": ["nslcd", "sssd"],
      "default": "nslcd"
    },
    "host": {
      "type": "string"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 389
    },
    "enablessl": {
      "type": "boolean",
      "default": false
    },
    "enablestarttls": {
      "type": "boolean",
      "default": false
    },
    "tlsreqcert": {
      "type": "string",
      "enum": ["never", "allow", "try", "demand", "hard"],
      "default": "demand"
    },
    "base": {
      "type": "string"
    },
    "rootbinddn": {
      "type": "string"
    },
    "rootbindpw": {
      "type": "string"
    },
    "usersuffix": {
      "type": "string",
      "default": "ou=Users"
    },
    "groupsuffix": {
      "type": "string",
      "default": "ou=Groups"
    },
    "machinesuffix": {
      "type": "string",
      "default": "ou=Computers"
    },
    "idmapsuffix": {
      "type": "string",
      "default": "ou=idmap"
    },
    "enablepam": {
      "type": "boolean",
      "default": true
    },
    "cachecredentials": {
      "type": "boolean",
      "default": true
    },
    "enumerate": {
      "type": "boolean",
      "default": false
    },
    "extraoptions": {
      "type": "string"
    },
    "extraclientoptions": {
      "type": "string"
    }
  }
}
